# Copy to .env for non-devcontainer runs. Inside the dev container these values
# are already injected by .devcontainer/docker-compose.yml — you don't need a
# .env there.

# Ports (forwarded by the dev container)
EDGE_PORT=8080
PORTAL_PORT=3001

# --- Deployment topology (portal) -------------------------------------------
# Served to the portal SPA at runtime by GET /api/v1/config, and used for the
# `url` on every app the API returns. The SPA ships prebuilt inside the portal
# image, so it must NOT burn any of this in at build time — there are no VITE_*
# build args for these on purpose.

# Scheme + host + port where apps are served, as reachable from the browser
# (architecture §4.1). Apps live at `<slug>.<this host>`. Default is the dev edge
# (mkcert TLS on :8080, resolves to 127.0.0.1); use `https://azx.helix.azxlabs.io`
# for prod. REQUIRED in production — the portal refuses to boot without it rather
# than hand out unreachable dev URLs.
APP_PUBLIC_BASE=https://local.helix.azxlabs.io:8080

# Base of the opt-in dev gateway (dev-mode design §3, `pnpm dev:devgw` on :8082).
# Leave unset/empty when it isn't running: the portal reports it as absent and the
# SPA says dev mode isn't enabled instead of showing an unreachable host.
DEV_API_PUBLIC_BASE=https://dev-api.local.helix.azxlabs.io:8082

# Display-only month-to-date platform spend watch line (USD) on the admin
# Activity page. Unset or 0 ⇒ no ceiling shown. Nothing enforces this — per-app
# daily token budgets are the real limit.
#
# Left unset here on purpose: local dev has no meaningful monthly spend, so a
# ceiling would just be noise. Real deploys DO get one — the Bicep defaults
# `platformMonthlyUsdCap` to 1000 (pass 0 there to opt out). Uncomment to
# exercise the near-cap/over-cap banners locally.
# PLATFORM_MONTHLY_USD_CAP=1000

# Postgres — dev container `db` service (host `db` on the compose network).
# DATABASE_URL is the schema owner: migrations run as it. The portal *runtime*
# connects as the least-privilege helix_portal role instead (full DML, not the
# owner — ADR-0002); required in production (owner fallback refused there).
DATABASE_URL=postgresql://helix:helix@db:5432/helix
PORTAL_DATABASE_URL=postgresql://helix_portal:helix_portal@db:5432/helix

# Azure Blob via Azurite — dev container `azurite` service.
# Well-known emulator account; not a secret.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1
