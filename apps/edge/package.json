{
  "name": "@azx-pbc/edge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/free-port.mjs ${EDGE_PORT:-8080} && tsx watch src/server.ts",
    "dev:devgw": "node ../../scripts/free-port.mjs ${EDGE_DEV_GATEWAY_PORT:-8082} && tsx watch src/devGateway/server.ts",
    "start": "node --import tsx src/server.ts",
    "start:devgw": "node --import tsx src/devGateway/server.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@azx-pbc/shared": "workspace:*",
    "@azx-pbc/telemetry": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "fastify": "catalog:",
    "jose": "catalog:",
    "openid-client": "catalog:",
    "pg": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@azx-pbc/dev-idp": "workspace:*",
    "@azx-pbc/dev-oauth-vendor": "workspace:*",
    "@azx-pbc/egress": "workspace:*",
    "@azx-pbc/portal": "workspace:*",
    "@azx-pbc/secret-store": "workspace:*",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
