    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "pg": "catalog:",
    "yauzl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "catalog:",
    "@types/pg": "catalog:",
    "@types/yauzl": "catalog:",
    "archiver": "catalog:",
    "form-data": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
