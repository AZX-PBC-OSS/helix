{
  "name": "@azx-pbc/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/free-port.mjs ${JOBS_PORT:-3003} && tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "db:migrate": "node --import tsx src/migrate.ts",
    "db:migrate:azure": "node --import tsx scripts/migrate-azure.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@azx-pbc/shared": "workspace:*",
    "@azx-pbc/secret-store": "workspace:*",
    "@azx-pbc/telemetry": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "fastify": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
