{
  "name": "@azx-pbc/helix-cli",
  "version": "0.1.0",
  "description": "Deploy CLI for Helix, the AZX App Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AZX-PBC-OSS/helix.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "helix": "./dist/helix.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "helix": "tsx src/bin.ts",
    "build": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "archiver": "catalog:",
    "openid-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@azx-pbc/dev-idp": "workspace:*",
    "@azx-pbc/shared": "workspace:*",
    "@types/archiver": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
