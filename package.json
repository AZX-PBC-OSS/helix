{
  "name": "helix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev:edge": "pnpm --filter @helix/edge dev",
    "dev:egress": "pnpm --filter @helix/egress dev",
    "dev:portal": "pnpm --filter @helix/portal dev",
    "dev:idp": "pnpm --filter @helix/dev-idp dev",
    "dev:web": "pnpm --filter @helix/portal-web dev",
    "dev:clean": "node scripts/free-port.mjs 8080 8081 3001 3002 5173",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
