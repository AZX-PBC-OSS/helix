# Build context excludes for the app images (build from repo root).
# Dependencies + build output are reinstalled/rebuilt inside the image.
**/node_modules
.pnpm-store
**/dist
**/build
**/*.tsbuildinfo

# Generated Prisma client (regenerated by the portal postinstall in-image)
apps/portal/src/db/generated

# VCS + dev-only tooling
.git
.github
.devcontainer
.vscode

# Local env / secrets — never bake into an image
**/.env
**/.env.*

# Tests / scratch / docs not needed at runtime
**/*.test.ts
scratchpad
infra
docs
