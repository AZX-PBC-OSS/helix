# Template for builder/bolt.diy/.env.local — wires bolt.diy's "OpenAILike"
# provider to the Helix builder gateway. setup.sh copies this into the clone.
# Replace the key with your EDGE_BUILDER_API_KEY (apps/edge/.env.local).
OPENAI_LIKE_API_BASE_URL=https://api.localtest.me:8080/v1
OPENAI_LIKE_API_KEY=replace-with-EDGE_BUILDER_API_KEY
